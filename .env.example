# Copy to the droplet or use as reference. Do not commit real secrets.
#
# GitHub → Settings → Secrets and variables → Actions
# Required:
#   DROPLET_HOST      = 203.0.113.10          (droplet public IP or DNS)
#   DROPLET_USER      = root                  (or deploy user with docker access)
#   DROPLET_SSH_KEY   = -----BEGIN OPENSSH PRIVATE KEY----- ...
#
# Optional:
#   DROPLET_PORT      = 22
#   DROPLET_APP_DIR   = /opt/go-ingestion-api
#   DROPLET_URL       = http://203.0.113.10   (for post-deploy smoke test)
#
# Also create GitHub Environment named: production
# (Workflow uses environment: production)

DROPLET_HOST=
DROPLET_USER=root
DROPLET_APP_DIR=/opt/go-ingestion-api
DROPLET_URL=http://YOUR_DROPLET_IP
